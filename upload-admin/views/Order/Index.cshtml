@using WangenPizza.Helper
@model IEnumerable<WangenPizza.Dtos.OrderDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Links {

    <link href="~/Dashboard/vendors/datatables.net-bs/css/dataTables.bootstrap.min.css" rel="stylesheet">
    <link href="~/Dashboard/vendors/datatables.net-buttons-bs/css/buttons.bootstrap.min.css" rel="stylesheet">
    <link href="~/Dashboard/vendors/datatables.net-fixedheader-bs/css/fixedHeader.bootstrap.min.css" rel="stylesheet">
    <link href="~/Dashboard/vendors/datatables.net-responsive-bs/css/responsive.bootstrap.min.css" rel="stylesheet">
    <link href="~/Dashboard/vendors/datatables.net-scroller-bs/css/scroller.bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.1/css/dataTables.bootstrap5.css" />
    @* jQuery/BS4 CDN removed: _Layout loads jQuery + Bootstrap 3; duplicates here broke admin menus. *@
    <style>
        /* Style for the Deletemodal */
        .Deletemodal {
            display: none; /* Hidden by default */
            position: fixed; /* Stay in place */
            z-index: 1; /* Sit on top */
            left: 0;
            top: 0;
            width: 100%; /* Full width */
            height: 100%; /* Full height */
            overflow: auto; /* Enable scroll if needed */
            background-color: rgb(0,0,0); /* Fallback color */
            background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
        }
        /* Deletemodal content */
        .Deletemodal-content {
            background-color: #fefefe;
            margin: 15% auto; /* 15% from the top and centered */
            padding: 20px;
            border: 1px solid #888;
            width: 300px; /* Could be more or less, depending on screen size */
            text-align: center;
        }
        /* The Close Button */
        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }

            .close:hover,
            .close:focus {
                color: black;
                text-decoration: none;
                cursor: pointer;
            }

        .button1 {
            margin: 5px;
            border: none;
            color: white;
            padding: 5px 20px;
            cursor: pointer;
            background-color: #007BFF;
        }

        .button2 {
            margin: 5px;
            border: none;
            background-color: red;
            color: white;
            padding: 5px 20px;
            cursor: pointer;
        }

    </style>
}

<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title" style="display: flex;justify-content: space-between;">


                <div class="container">
                    <div class="row">
                        <div class="col-md-6">
                            <h2 style="overflow:initial;font-weight: 800;font-size: 20px;">
                                Aktuelle Bestellungen
                            </h2>
                        </div>
                        <div class="col-md-6">
                            @if (TempData["OrderMessage"] is string orderMessage)
                            {
                                <div class="alert alert-info">@orderMessage</div>
                            }
                            <form asp-action="DeleteHistoryByDate" method="post">
                                <div class="form-group">
                                    <label for="fromDate">From Date:</label>
                                    <input id="fromDate" name="fromDate" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label for="toDate">To Date:</label>
                                    <input id="toDate" name="toDate" class="form-control" required />
                                </div>
                                <button type="submit" class="btn btn-danger mt-2">Delete Orders</button>
                            </form>
                            <form asp-action="RestoreDeletedByDate" method="post" style="margin-top:16px;">
                                <div class="form-group">
                                    <label for="restoreDate">Gelöscht am:</label>
                                    <input id="restoreDate" name="restoreDate" class="form-control" required />
                                </div>
                                <button type="submit" class="btn btn-primary mt-2">Zurückholen</button>
                            </form>
                        </div>
                    </div>
                </div>



                <div class="clearfix"></div>
            </div>
            <div class="x_content">

                <table id="example" class="table table-striped table-bordered ">
                    <thead>
                        <tr>
                            <th class="sorting_disabled sorting_desc">
                                Bestell-Nr.
                            </th>
                            <th class="sorting_disabled sorting ">Name</th>
                            <th class="sorting_disabled sorting ">Strasse</th>
                            <th class="sorting_disabled sorting ">PLZ / Ort</th>
                            <th class="sorting_disabled sorting ">Lieferzeit</th>
                            <th class="sorting_disabled sorting ">Status</th>
                            <th class="sorting_disabled sorting ">CHF</th>

                            <th>Aktion</th>
                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="margin:auto;font-size: 16px;font-weight: 600;">@item.Id</td>
                                <td style="margin:auto;font-size: 16px;font-weight: 600;">@item.Name</td>
                                <td style="margin:auto;font-size: 16px;font-weight: 600;">@item.Street</td>
                                <td style="margin:auto;font-size: 16px;font-weight: 600;">@item.City</td>
                                <td style="margin:auto;font-size: 16px;font-weight: 600;">
                                    @OrderConfirmationMailHelper.FormatOrderWishDisplay(item.DeliveryDate, item.DeliveryTime)
                                </td>
                                @if (item.IsPrinted == true)
                                {
                                    <td class="text-center">
                                        <span class="label label-success">gedruckt</span><br />
                                        @if (item.Pickup_type == "Pickup")

                                        {
                                            <span class="label label-warning">Abholung  </span>
                                        }
                                        else
                                        {
                                            <span class="label label-primary"> Lieferung   </span>
                                        }
                                    </td>

                                }
                                else
                                {
                                    <td class="text-center">
                                        <span class="label label-danger ">Nicht gedruckt </span><br />
                                        @if (item.Pickup_type == "delivery")

                                        {
                                            <span class="label label-primary">Lieferung    </span>
                                        }
                                        else
                                        {
                                            <span class="label label-warning"> Abholung </span>
                                        }
                                    </td>
                                }

                                <td style="margin:auto;font-size:16px;font-weight:600; color:@(item.PaymentWay == 1 ? "red" : "green")">
                                    @(item.PaymentWay == 1 ? "Bar" : "")
                                </td>

                                <td>
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info "><i class="fa fa-pencil"></i> Bearbeiten </a>
                                    <a asp-controller="Order" asp-action="Print" asp-route-id="@item.Id" target="_blank" class="btn btn-warning"><i class="fa fa-print"></i> Drucken </a>
                                    <a onclick="confirmDelete('@item.Id')" class="btn btn-danger "><i class="fa fa-pencil"></i> Löschen </a>




                                </td>
                               
                            </tr>
                        }


                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div id="myDeletemodal" class="Deletemodal">

    <!-- Deletemodal content -->
    <div class="Deletemodal-content">
        <span class="close">&times;</span>
        <p>Möchten Sie diesen Datensatz wirklich löschen?</p>
        <button id="confirmBtn" class="button1">Ok</button>
        <button id="cancelBtn" class="button2">Abbrechen</button>
    </div>

</div>

@section Scripts {
    <!-- Datatables -->
    <script src="~/Dashboard/vendors/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-buttons-bs/js/buttons.bootstrap.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-buttons/js/buttons.flash.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-buttons/js/buttons.print.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-fixedheader/js/dataTables.fixedHeader.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-keytable/js/dataTables.keyTable.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-responsive-bs/js/responsive.bootstrap.js"></script>
    <script src="~/Dashboard/vendors/datatables.net-scroller/js/dataTables.scroller.min.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script>
        $(function () {
            // Apply datepicker to both fromDate and toDate inputs
            $("input[name='fromDate'], input[name='toDate'], input[name='restoreDate']").datepicker({
                dateFormat: 'dd.mm.yy'
            });
        });
    </script>


    <script>
        function confirmDelete(itemId) {
            var Deletemodal = document.getElementById("myDeletemodal");
            var span = document.getElementsByClassName("close")[0];
            var confirmBtn = document.getElementById("confirmBtn");
            var cancelBtn = document.getElementById("cancelBtn");

            // Display the Deletemodal
            Deletemodal.style.display = "block";

            // When the user clicks on <span> (x), close the Deletemodal
            span.onclick = function () {
                Deletemodal.style.display = "none";
            }

            // When the user clicks on "No", close the Deletemodal
            cancelBtn.onclick = function () {
                Deletemodal.style.display = "none";
            }

            // When the user clicks on "Yes", redirect to delete URL
            confirmBtn.onclick = function () {
                window.location.href = '@Url.Action("Delete", "Order")/' + itemId;
            }

            // When the user clicks anywhere outside of the Deletemodal, close it
            window.onclick = function (event) {
                if (event.target == Deletemodal) {
                    Deletemodal.style.display = "none";
                }
            }
        }
    </script>

    <script>
        $(document).ready(function () {
            $('#example').dataTable({
                "ordering": false
            });
        });
    </script>

    
}
