<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / SmarterASP: Verhindert, dass /assets/* oder /Images/* fälschlich auf index.html
  umgeschrieben werden (sonst liefert der Server HTML statt JS/CSS/Bilder → „kaputte“ Seite).
  SPA-Routen: Vorab-HTML pro indexierbarer Route (z. B. kontakt.html); alles andere ohne physische Datei → _app.html (meta robots noindex).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Dotfiles (/.env, /.git/*, /.htaccess ...) -> 404. /.well-known/ bleibt erreichbar. -->
        <rule name="Block dotfiles" stopProcessing="true">
          <match url="(^|/)\.[^/]" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <!-- E-Mail-Link "Bestellung verfolgen": /bestellung-verfolgen?id=123 -> /order-tracking?id=123 (Query bleibt; temporaer, ein Hop) -->
        <rule name="Bestellung verfolgen to order-tracking" stopProcessing="true">
          <match url="^bestellung-verfolgen/?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.pizzawangen.ch/order-tracking" appendQueryString="true" redirectType="Found" />
        </rule>
        <!-- Google/Maps nutzt oft http://pizzawangen.ch ohne www → immer https://www -->
        <rule name="Force HTTPS and WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^pizzawangen\.ch$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.pizzawangen.ch/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Alter/falscher Link /datenschutz -> Hauptseite /datenschutzbestimmungen (301, dauerhaft) -->
        <rule name="Datenschutz to datenschutzbestimmungen" stopProcessing="true">
          <match url="^datenschutz/?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.pizzawangen.ch/datenschutzbestimmungen" redirectType="Permanent" />
        </rule>
        <!-- Vorab-HTML pro Route (scripts/prerender.mjs): /kontakt -> kontakt.html, ohne Redirect und ohne Slash-Weiterleitung -->
        <rule name="Prerendered route" stopProcessing="true">
          <match url="^([^./]+)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
        <rule name="SPA index — keine Rewrite für Bundles" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Root /site/ und Unterordner z. B. /site1/assets -->
            <add input="{REQUEST_URI}" pattern="^/(site\d+/)?assets(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(site\d+/)?Images(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="\.(js|css|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|map|json)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="_app.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <!-- Sicherheits-Header fuer alle Antworten. Bewusst noch ohne Content-Security-Policy. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- index.html: immer neu laden (neue Hashes in index → neue Bundles). assets/*: lang cachen (Vite-Dateinamen sind gehasht). -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="_app.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="menue.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="angebote.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="gutscheine.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="restaurant.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="reservation.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="kontakt.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="impressum.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="agb.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="datenschutzbestimmungen.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="pizza-lieferung-lachen.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="pizza-siebnen.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="pizza-altendorf.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="pizza-tuggen.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="kebab-wangen.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="doener-wangen.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
