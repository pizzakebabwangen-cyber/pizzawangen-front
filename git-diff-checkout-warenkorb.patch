+    if (!plz) {
+      const fromPc = (localStorage.getItem(LS_DELIVERY_POSTCODE) || "").match(/\d{4}/);
+      if (fromPc) plz = fromPc[0];
+    }
+  }
+  const tail = [plz, ort].filter(Boolean).join(" ").trim();
+  if (!tail) return q;
+  return `${q} ${tail}`.trim();
+};
